{"versionId":-2,"visualScriptId":"049688a9-f9b4-4ff5-83a0-eacc472d1c3d","managedNetworks":["Default"],"name":"Script - Check Flash Capacity","author":"jayde","description":"Check the flash capacity and calculate total, free and used space","nodes":[{"nodeId":"47ac2956-be02-42e8-8fe7-56c7c09ab1a1","versionId":722,"type":"device_search","alias":"Pick Devices","nodeConfig":{"resolution": {"ipData": "\"Cisco\",\"\",\"<\",\"\"\n\"Firewall\",\"Router\",\"Switch\",\"Wireless Controller\",\"Load Balancer\"\nc3850*", "ipScheme": "\"vendor\",\"deviceType\",\"hostname\"", "networks": ["Default", "OttawaLab"]}},"nodeProperties":{"x": 589.0579752953813, "y": 139.21447905477982, "data": {"name": "device_search", "config": {"resolution": {"type": "device_resolution"}}, "inputs": [], "outputs": [{"name": "device", "tags": [], "type": "Model", "description": "Matching devices.", "typeInference": "None", "emittedVariables": [], "typeInferenceMatchName": ""}], "category": "Input", "description": "Queries inventory, emits matching devices.", "isStartNode": true, "scriptExtension": {"state": null}, "importConfigFixer": {}, "requiredPermissions": ["org.ziptie.playbook.cudPermission"], "requiredEntitlements": ["Playbooks"]}}},{"nodeId":"73832801-df73-4227-a845-5989e37f4624","versionId":722,"type":"script_exec","alias":"Format Data","nodeConfig":{"script": "import re\n\nfrom logicvein import get_input, flush_output\n\n\n\"\"\"Main code.\"\"\"\ndevice_output = get_input(\"cli_output\")\n\n# Intialize lists and dicts.\nbyte_labels = [\"total\", \"free\", \"used\"]\nbytes = {}\nbin_files = []\nresults = {}\n\n# Look for total, free and used bytes from the output and set the results variables.\nfor label in byte_labels:\n    # Initialize results.\n    bytes[label] = 0\n    results[label] = \"unknown\"\n    # Search for pattern in the previous node's result string.\n    pattern = rf\"(\\d+) bytes {label}\"\n    match = re.search(pattern, device_output)\n    if match:\n        # Get matching bytes, convert to MB and assign to results.\n        bytes[label] = round(int(match.group(1)) / 1024 /1024, 2)\n        results[label] = f\"{bytes[label]} MB\"\n\n# Calculate used bytes from total and free if it wasn't found in the device output.\nif results[\"used\"] == \"unknown\" and results[\"total\"] != \"unknown\" and results[\"free\"] != \"unknown\":\n    bytes[\"used\"] = round(bytes[\"total\"] - bytes[\"free\"], 2)\n    results[\"used\"] = f\"{bytes['used']} MB\"\n\n# Find bin files.\nbin_files = re.findall(r\"\\s(\\S+\\.bin)\", device_output)\nresults[\"bin_files\"] = \",\".join(bin_files)\n\n# Format and print the output for the next node.\nflush_output(**results)\n", "version": 1},"nodeProperties":{"x": 590.693672066175, "y": 364.1887499913471, "data": {"name": "script_exec", "config": {"script": {"type": "String"}, "scriptFile": {"type": "String"}}, "inputs": [{"name": "prev", "type": "Any", "autowire": "None", "autowireOn": "NoConnection", "inputUsage": "User", "isOptional": false, "description": "", "typeInference": "None"}], "outputs": [{"name": "output", "tags": [], "type": "Model", "description": "", "typeInference": "None", "emittedVariables": [], "typeInferenceMatchName": ""}, {"name": "eachOutput", "tags": [], "type": "Model", "description": "", "typeInference": "None", "emittedVariables": [], "typeInferenceMatchName": ""}, {"name": "error", "tags": ["Error"], "type": "Model", "description": "", "typeInference": "None", "emittedVariables": [], "typeInferenceMatchName": ""}], "category": "Control", "description": "", "isStartNode": false, "scriptExtension": {"state": null}, "importConfigFixer": {}, "requiredPermissions": ["org.ziptie.playbook.cudPermission", "org.ziptie.playbook.scriptNode.cudPermission"], "requiredEntitlements": ["Playbooks"]}}},{"nodeId":"9042fd5b-e63b-408d-91f0-e4e9b9b358ef","versionId":722,"type":"run_code","alias":"Show Flash","nodeConfig":{"block": {"type": "COMMAND", "prompt": "", "matchBy": "Regex", "commands": "dir", "respo