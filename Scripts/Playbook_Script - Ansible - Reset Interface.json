{"versionId":-2,"visualScriptId":"1f6deeaf-dfd2-4883-ba7a-ed258f1ab8e6","managedNetworks":["Default"],"name":"Script - Ansible - Reset Interface","author":"jayde","description":"Shut and no shut a specific interface name using Ansible","nodes":[{"nodeId":"3ab24467-abff-406e-9b56-29cc9197002c","versionId":903,"type":"script_exec","alias":"Run Stored Ansible YAML","nodeConfig":{"script": "# Import our custom script utilities.\nimport lvi_script_sandbox_utils as lvi\n\n# Run the existing Ansible Playbook.\nresult = lvi.run_ansible(\n    \"reset_interface.yaml\", \n    {\"interface\": lvi.get(\"interface\")}\n)\n\n# Fail if result not 'ok'.\nif not result.ok:\n    lvi.fail(result.message)\n\n# Get the device output from the Ansible Playbook tasks.\nshutdown_confirmation = result.task(\"Confirm Interface is Shutdown\")[\"result\"][\"stdout\"][0]\nno_shutdown_confirmation = result.task(\"Confirm Interface is Up\")[\"result\"][\"stdout\"][0]\n\n# Output the device version info and the Ansible Playbook result details.\nlvi.set(shutdown_confirmation, no_shutdown_confirmation, **result.to_globals())", "version": 1},"nodeProperties":{"x": 684.75, "y": 308.5, "data": {"name": "script_exec", "config": {"script": {"type": "String"}, "scriptFile": {"type": "String"}}, "inputs": [{"name": "prev", "type": "Any", "autowire": "None", "autowireOn": "NoConnection", "inputUsage": "User", "isOptional": false, "typeInference": "None"}], "outputs": [{"name": "output", "tags": [], "type": "Model", "typeInference": "None", "typeInferenceMatchName": ""}, {"name": "eachOutput", "tags": [], "type": "Model", "typeInference": "None", "typeInferenceMatchName": ""}, {"name": "error", "tags": ["Error"], "type": "Model", "typeInference": "None", "typeInferenceMatchName": ""}], "category": "Control", "isStartNode": false, "scriptExtension": {"state": null}, "importConfigFixer": {}, "requiredPermissions": ["org.ziptie.playbook.cudPermission", "org.ziptie.playbook.scriptNode.cudPermission"], "requiredEntitlements": ["Playbooks"]}}},{"nodeId":"4e637f23-a940-44e6-ac45-e58f62785d3a","versionId":903,"type":"memo","alias":"Ansible YAML (on host)","nodeConfig":{"content": "<p>-&nbsp;hosts:&nbsp;all</p><p>&nbsp;&nbsp;gather_facts:&nbsp;false</p><p>&nbsp;&nbsp;tasks:</p><p>&nbsp;&nbsp;&nbsp;&nbsp;-&nbsp;name:&nbsp;Shutdown&nbsp;Interface</p><p>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;cisco.ios.ios_config:</p><p>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;lines:</p><p>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;-&nbsp;shutdown</p><p>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;parents:&nbsp;interface&nbsp;{{&nbsp;interface&nbsp;}}</p><p>&nbsp;&nbsp;&nbsp;&nbsp;-&nbsp;name:&nbsp;Confirm&nbsp;Interface&nbsp;is&nbsp;Shutdown</p><p>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;cisco.ios.ios_command:</p><p>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;commands:&nbsp;show&nbsp;interface&nbsp;{{&nbsp;interface&nbsp;}}</p><p>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;wait_for:&nbsp;result[0]&nbsp;contains&nbsp;&quot;administratively&nbsp;down&quot;</p><p>&nbsp;&nbsp;&nbsp;&nbsp;-&nbsp;name:&nbsp;Bring&nbsp;Interface&nbsp;Up</p><p>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;cisco.ios.ios_config:</p><p>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;lines:</p><p>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;-&nbsp;no&nbsp;shutdown</p><p>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;parents:&nbsp;interface&nbsp;{{&nbsp;interface&nbsp;}}</p><p>&nbsp;&nbsp;&nbsp;&nbsp;-&nbsp;name:&nbsp;Confirm&nbsp;Interface&nbsp;is&nbsp;Up</p><p>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;cisco.ios.ios_command:</p><p>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;commands:&nbsp;show&nbsp;interface&nbsp;{{&nbsp;interface&nbsp;}}</p><p>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;wait_for:&nbsp;result[0]&nbsp;contains&nbsp;&quot;is&nbsp;up&quot;</p>", "plainText": "- hosts: all\n  gather_facts: false\n  tasks:\n    - name: Shutdown Interface\n      cisco.ios.ios_config:\n        lines:\n          - shutdown\n        parents: interface {{ interface }}\n    - name: Confirm Interface is Shutdown\n      cisco.ios.ios_command:\n        commands: show interface {{ interface }}\n        wait_for: result[0] contains \"administratively down\"\n    - name: Bring Interface Up\n      cisco.ios.ios_config:\n        lines:\n          - no shutdown\n        parents: interface {{ interface }}\n    - name: Confirm Interface is Up\n      cisco.ios.ios_command:\n        commands: show interface {{ interface }}\n        wait_for: result[0] contains \"is up\""},"nodeProperties":{"x": 383.35386178861796, "y": 453.9430894308944, "data": {"name": "memo", "config": {"content": {"type": "String"}}, "inputs": [], "outputs": [{"name": "content", "tags": ["AlwaysFullOutput"], "type": "Model", "typeInference": "None", "typeInferenceMatchName": ""}], "category": "Input", "isStartNode": false, "scriptExtension": {"state": null}, "importConfigFixer": {}, "requiredPermissions": ["org.ziptie.playbook.cudPermission"], "requiredEntitlements": ["Playbooks"]}}},{"nodeId":"711a1143-122b-4600-bf02-091efbc44862","versionId":903,"type":"device_search","alias":"Set Int Replacement Value","nodeConfig":{"resolution": {"ipData": "a26beaf2-ad88-48a4-bd35-456ac8fdc873\nus*", "ipScheme": "\"group\",\"hostname\"", "networks": ["Default"]}, "replacements": {"mode": "perjob", "values": {"all": {"interface": {"value": "Ethernet0/3", "isError": false, "isChanged": true}}}, "replacements": [{"key": "cc399bc8-777b-420c-b491-ee60bb785219", "name": "interface", "type": "string", "values": "", "children": [], "entryType": "replacement", "originalText": "Fa0/9", "isOriginalDefault": true}]}},"nodeProperties":{"x": 383, "y": 309, "data": {"name": "device_search", "config": {"resolution": {"type": "device_resolution"}, "replacements": {"type": "DeviceReplacementMap"}}, "inputs": [], "outputs": [{"name": "device", "tags": [], "type": "Model", "typeInference": "None", "typeInferenceMatchName": ""}], "category"