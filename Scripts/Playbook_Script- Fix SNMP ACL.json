utputs": [{"name": "changed", "tags": [], "type": "Model", "description": "Devices with changed config", "typeInference": "None", "emittedVariables": [], "typeInferenceMatchName": ""}, {"name": "unchanged", "tags": [], "type": "Model", "description": "Devices with unchanged config", "typeInference": "None", "emittedVariables": [], "typeInferenceMatchName": ""}, {"name": "failures", "tags": ["Error"], "type": "Model", "description": "Devices with failure", "typeInference": "None", "emittedVariables": ["error"], "typeInferenceMatchName": ""}, {"name": "skipped", "tags": ["Error"], "type": "Model", "description": "Skipped devices", "typeInference": "None", "emittedVariables": [], "typeInferenceMatchName": ""}], "category": "Command", "description": "Backs up device config.", "isStartNode": false, "scriptExtension": {"state": null}, "importConfigFixer": {}, "requiredPermissions": ["org.ziptie.playbook.cudPermission"], "requiredEntitlements": ["Playbooks"]}}},{"nodeId":"ea5ca4f4-ce9b-493a-8c1a-73737aae2200","versionId":704,"type":"script_exec","alias":"Create Config Commands","nodeConfig":{"script": "from logicvein import get_input, flush_string_output\n\nACL_NAME = \"SNMP-POLICER-ACL\"\n\nCORRECT_LINES = [\n    f\"ip access-list extended {ACL_NAME}\",\n    \" 10 permit udp host 10.50.10.222 any eq snmp\",\n    \" 20 permit udp host 10.50.10.157 any eq snmp\",\n    \" 30 permit udp host 10.50.10.199 any eq snmp\",\n    \" 40 deny ip any any\",\n]\n\ndef _extract_acl_block(config):\n    \"\"\"\n    Return the lines belonging to the SNMP-POLICER-ACL block, or None if the\n    header line is not present at all.\n\n    The block starts at the 'ip access-list extended SNMP-POLICER-ACL' header\n    and ends just before the next non-indented (non-space-prefixed) line or\n    the end of the string.\n    \"\"\"\n    lines = config.splitlines()\n    header = f\"ip access-list extended {ACL_NAME}\"\n\n    # Find the header line\n    start_idx = None\n    for i, line in enumerate(lines):\n        if line.rstrip() == header:\n            start_idx = i\n            break\n\n    if start_idx is None:\n        return None\n\n    block = [lines[start_idx].rstrip()]\n    for line in lines[start_idx + 1 :]:\n        stripped = line.rstrip()\n        # ACL entries are indented; a non-empty, non-indented line ends the block\n        if stripped and not stripped.startswith(\" \"):\n            break\n        # Skip blank lines (they would constitute \"extra lines between entries\")\n        # but we still capture them so the exact-match check can flag them.\n        block.append(stripped)\n\n    # Remove trailing blank lines so they don't cause false failures\n    while block and block[-1] == \"\":\n        block.pop()\n\n    return block\n\n\ndef check(running_config):\n    \"\"\"\n    Validate the ACL in *running_config*.\n\n    Returns:\n        None  – ACL is present and exactly correct; no action needed.\n        str   – Multi-line IOS command string to remediate.\n    \"\"\"\n    block = _extract_acl_block(running_config)\n\n    if block == CORRECT_LINES:\n        return None  # Already correct\n\n    # Build remediation commands\n    needs_no_command = block is not None  # ACL exists but is wrong\n    commands = [\"conf t\"]\n    if needs_no_command:\n        commands.append(f\"no ip access-list extended {ACL_NAME}\")\n    commands.extend(CORRECT_LINES)\n    commands.append(\"end\")\n    commands.append(\"wr mem\")\n\n    return \"\\n\".join(commands)\n\n\nif __name__ == \"__main__\":\n    results = {}\n    running_config = get_input(\"cli_output\")\n    result = check(running_config)\n    if result is None:\n        output = \"! no change needed\"\n    else:\n        output = result\n    flush_string_output(output)\n", "version": 1},"nodeProperties":{"x": 809.7048680835836, "y": 127.59072540309782, "data": {"name": "script_exec", "config": {"script": {"type": "String"}, "scriptFile": {"type": "String"}}, "inputs": [{"name": "prev", "type": "Any", "autowire": "None", "autowireOn": "NoConnection", "inputUsage": "User", "isOptional": false, "description": "", "typeInference": "None"}], "outputs": [{"name": "output", "tags": [], "type": "Model", "description": "", "typeInference": "None", "emittedVariables": [], "typeInferenceMatchName": ""}, {"name": "eachOutput", "tags": [], "type": "Model", "description": "", "typeInference": "None", "emittedVariables": [], "typeInferenceMatchName": ""}, {"name": "error", "tags": ["Error"], "type": "Model", "description": "", "typeInference": "None", "emittedVariables": [], "typeInferenceMatchName": ""}], "category": "Control", "description": "", "isStartNode": false, "scriptExtension": {"state": null}, "importConfigFixer": {}, "requiredPermissions": ["org.ziptie.playbook.cudPermission", "org.ziptie.playbook.scriptNode.cudPermission"], "requiredEntitlements": ["Playbooks"]}}}],"edges":[{"edgeId":"3847212b-282d-4861-ad73-494f2e312f8a","versionId":704,"fromNode":"53d0631a-862a-4e86-805a-2470e1a9181d","fromHandle":"device","toNode":"d0afc324-06fa-45eb-affc-a0d14bd7cf4d","toHandle":"device"},{"edgeId":"743ad62f-5a57-43ba-b8bd-c63b9caee73b","versionId":704,"fromNode":"ea5ca4f4-ce9b-493a-8c1a-73737aae2200","fromHandle":"output","toNode":"5001efb5-8041-4cc9-a5d1-3b0cfa1c6a19","toHandle":"textToValidate"},{"edgeId":"a7ab40e4-12c1-4ae9-b9f4-04f407f21094","versionId":704,"fromNode":"d0afc324-06fa-45eb-affc-a0d14bd7cf4d","fromHandle":"next","toNode":"ea5ca4f4-ce9b-493a-8c1a-73737aae2200","toHandle":"prev"},{"edgeId":"bc562425-a472-4ecd-b141-e36afc45b6f7","versionId":704,"fromNode":"5001efb5-8041-4cc9-a5d1-3b0cfa1c6a19","fromHandle":"matches","toNode":"316a31ba-e7c4-4a1f-978c-7052e7041e2e","toHandle":"device"},{"edgeId":"dfd6b85a-8669-4a50-898d-1815962c7d97","versionId":704,"fromNode":"316a31ba-e7c4-4a1f-978c-7052e7041e2e","fromHandle":"output","toNode":"e15203ad-bcda-4f5c-9d3e-e6d1bcddc25e","toHandle":"device"}],"canUserEdit":true}